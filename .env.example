# Copia este archivo como .env (en la raíz del proyecto) y llena los valores.
# El archivo .env está en .gitignore: nunca lo subas a GitHub.

# Contraseña del usuario SA del contenedor de SQL Server (docker-compose)
DB_SA_PASSWORD=cambia-esta-contraseña

# Contraseña del usuario app_inmuebles que usa la API
DB_PASSWORD=cambia-esta-contraseña

# Clave para firmar los JWT (mínimo 64 caracteres aleatorios).
# Puedes generar una con: openssl rand -hex 32
JWT_SECRET=pega-aqui-una-clave-aleatoria-larga

# Contraseña de aplicación de Gmail (myaccount.google.com/apppasswords)
MAIL_PASSWORD=pega-aqui-tu-contraseña-de-aplicacion
